# Iteratively align the target frame (on the other component, carried by a goniometer)
# to the assembly frame of the given component. The assembly component may be gripped
# or lie anywhere except on the same goniometer as the target component.
# The laser frames the target frame depends on are measured in every iteration, then
# the assembly instruction is recalculated before the goniometer is aligned.
# The service name decides the sensor (..._laser or ..._confocal).
string component_name
# Number of measure/align iterations (must be at least 1).
int32 num_iterations 2
---
bool success
string message
string assembly_frame
string target_frame
string target_component
string[] frames_measured
# Per iteration: how far gonio stage 1 and stage 2 moved (deg)
float64[] gonio_stage_1_moved_deg
float64[] gonio_stage_2_moved_deg
